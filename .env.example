# ===========================================
# WP Launcher - Environment Configuration
# ===========================================
# Copy this file to .env and adjust values

# Network Configuration
APP_HOST=192.168.1.100       # Your server's local IP address
APP_PORT=5000                # Web interface port

# Security — REQUIRED
# The app refuses to start without this. It signs session cookies AND derives
# the encryption key for stored SSH deployment keys, so rotating it logs
# everyone out and invalidates saved keys.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ===========================================
# Deployment mode
# ===========================================
# Defaults target a self-hosted VPS: everything listens on loopback and the
# session cookie is HTTPS-only. Set this to true on a laptop or LAN box to
# restore the permissive local behaviour.
# WPL_LOCAL_MODE=false

# Listening interfaces. All three default to 127.0.0.1, or 0.0.0.0 when
# WPL_LOCAL_MODE=true. Override individually if needed.
# WPL_BIND=127.0.0.1         # WP Launcher itself
# WPL_SITE_BIND=127.0.0.1    # Project sites (WordPress, Next.js)
# WPL_ADMIN_BIND=127.0.0.1   # phpMyAdmin, Mailpit, MySQL, Mongo Express
#
# Admin side-cars ship with static credentials and no TLS — keep them on
# loopback and reach them through an SSH tunnel:
#   ssh -L 8081:127.0.0.1:8081 user@your-vps

# ===========================================
# Bouton « Ouvrir dans VS Code »
# ===========================================
# Les fichiers des sites vivent sur la machine qui héberge WP Launcher. Quand
# le navigateur tourne ailleurs, le bouton ouvre VS Code en Remote-SSH — il
# faut donc lui donner la cible SSH : un alias ~/.ssh/config ou user@hote,
# tel que vous l'écririez après `ssh `.
# Défaut : utilisateur courant @ APP_HOST.
# WPL_VSCODE_SSH_HOST=dev@192.168.1.100
#
# Schéma d'URI, à changer pour un fork de VS Code (cursor, vscode-insiders,
# vscodium, windsurf...).
# WPL_VSCODE_SCHEME=vscode

# Number of reverse proxies in front of the app. Needed so the login throttle
# sees real client IPs instead of the proxy's. Set to 0 if nothing fronts it.
# WPL_TRUSTED_PROXIES=1

# Session
# SESSION_COOKIE_SECURE=true # forced on unless WPL_LOCAL_MODE=true
# WPL_SESSION_LIFETIME=43200 # seconds (12h; 30 days in local mode)

# ===========================================
# Project defaults
# ===========================================
# New projects get a random MySQL/Mongo password each. Set this to true only
# if you have external tooling that hard-codes the historical values
# (wordpress / rootpassword). Existing projects are unaffected either way.
# WPL_LEGACY_PROJECT_CREDENTIALS=false

# WordPress admin account created for new projects. This is a single global
# credential shared by every project, and it is passed to the UI's one-click
# autologin as a URL query parameter — so treat it as low-value and never
# reuse a password from elsewhere.
#
# install.sh generates a random one. If you set it by hand, do not leave it
# as "admin": the app logs a warning at startup when it is.
#   python3 -c "import secrets; print(secrets.token_urlsafe(18))"
#
# Changing it later only affects newly created projects; existing sites keep
# the password they were installed with, and their autologin button will stop
# working until you update them in WordPress.
WP_ADMIN_USER=admin
# Laissée commentée volontairement : une valeur vide n'est PAS traitée comme
# absente par tous les lecteurs d'env, et provisionnerait des sites au mot de
# passe vide. Décommentez avec votre propre valeur.
# WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=admin@example.com
WP_LOCALE=en_US

# Optional: GitHub OAuth (for multi-developer features)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
