__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
config/__pycache__/
routes/__pycache__/
services/__pycache__/
utils/__pycache__/

# Data directories
projets/
uploads/
containers/
containers
data/
logs/
snapshots/

# Symlinks
app/utils/projets
app/utils/containers

# Sensitive configuration
.env
.env.backup-*

# Key material and certificates — deliberately broad. Reverse-proxy state
# (ACME account keys, issued certs) must never reach a commit.
traefik/
acme.json
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
id_ed25519*

# Databases (data/ already ignored, but projects and dumps land elsewhere)
*.db
*.sqlite
*.sqlite3

# Runtime state that names internal hosts
exposed_sites.json

# Recovery dumps (MySQL rescue snapshots)
.recovery-backup/

# Local pytest cache
.pytest_cache/

# IDE
.vscode/
.idea/

# History and cache
.claude/
.history/

# WordPress - Docker template
docker-template/wordpress/