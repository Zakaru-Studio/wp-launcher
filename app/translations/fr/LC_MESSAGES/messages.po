# — Deployment targets (one-click redeploy feature) —
msgid "Deployment targets"
msgstr "Cibles de déploiement"

msgid "Saved configurations you can re-deploy in one click."
msgstr "Configurations enregistrées, redéployables en un clic."

msgid "New target"
msgstr "Nouvelle cible"

msgid "Edit target"
msgstr "Modifier la cible"

msgid "Target name"
msgstr "Nom de la cible"

msgid "e.g. Numerik → staging"
msgstr "ex. Numerik → staging"

msgid "Leave empty to use the project default branch."
msgstr "Laisser vide pour utiliser la branche par défaut du projet."

msgid "Redeploy"
msgstr "Redéployer"

msgid "History"
msgstr "Historique"

msgid "Never deployed"
msgstr "Jamais déployé"

msgid "Failed to load targets."
msgstr "Échec du chargement des cibles."

msgid "No runs yet for this target."
msgstr "Aucun déploiement pour cette cible."

msgid "No saved target yet. Click \"New target\" to create one."
msgstr "Aucune cible enregistrée. Cliquez sur « Nouvelle cible » pour en créer une."

msgid "Redeploy {project} on {server} ({branch})?"
msgstr "Redéployer {project} sur {server} ({branch}) ?"

msgid "This project has no deployment folder yet — create it below."
msgstr "Ce projet n'a pas encore de dossier de déploiement — créez-le ci-dessous."

msgid "Push media"
msgstr "Pousser les médias"

msgid "Media push"
msgstr "Push médias"

msgid "Send the dev media library (adds and updates only, never deletes on the server)"
msgstr "Envoyer la médiathèque de dev (ajouts et mises à jour uniquement, aucune suppression sur le serveur)"

msgid "Send the dev media of {project} to {server} ({env})?"
msgstr "Envoyer les médias de dev du projet {project} vers {server} ({env}) ?"

msgid "Only missing or modified files are sent. Nothing is deleted on the server."
msgstr "Seuls les fichiers manquants ou modifiés sont envoyés. Rien n'est supprimé sur le serveur."

msgid "Media push refused."
msgstr "Push des médias refusé."

msgid "Push DB"
msgstr "Pousser la BDD"

msgid "DB push"
msgstr "Push BDD"

msgid "Overwrite the remote database with the dev one (URLs rewritten, remote backup taken)"
msgstr "Écraser la base distante avec celle de dev (URLs réécrites, sauvegarde distante effectuée)"

msgid "Overwrite the database of {server} ({env}) with the dev database of {project}?"
msgstr "Écraser la base de données de {server} ({env}) avec celle de dev du projet {project} ?"

msgid "URLs are rewritten automatically and a backup of the remote database is written on the server before the import."
msgstr "Les URLs sont réécrites automatiquement et une sauvegarde de la base distante est écrite sur le serveur avant l'import."

msgid "PRODUCTION — type the project name ({project}) to confirm the database overwrite:"
msgstr "PRODUCTION — saisissez le nom du projet ({project}) pour confirmer l'écrasement de la base :"

msgid "Database push aborted."
msgstr "Push de la base annulé."

msgid "Database push refused."
msgstr "Push de la base refusé."

